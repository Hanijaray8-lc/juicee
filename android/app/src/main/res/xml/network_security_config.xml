<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Base config: trust system CAs for all connections -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <!-- Primary production backend: juicyapp.in -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">juicyapp.in</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- Secondary production backend / fallback: juicy.lcind.space -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">juicy.lcind.space</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- Legacy backend (Render) -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">onrender.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- Allow cleartext for Capacitor WebView and local dev -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
