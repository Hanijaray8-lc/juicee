{
  "appId": "com.juicychat.app",
  "appName": "Juicy",
  "webDir": "build",
  "server": {
    "allowNavigation": [
      "juicyapp.in",
      "*.juicyapp.in"
    ]
  },
  "plugins": {
    "Camera": {
      "permissions": [
        "camera",
        "photos"
      ]
    },
    "Microphone": {
      "permissions": [
        "microphone"
      ]
    },
    "StatusBar": {
      "style": "dark",
      "backgroundColor": "#FF2E7E",
      "overlaysWebView": false
    },
    "Keyboard": {
      "resize": "native",
      "style": "dark",
      "resizeOnFullScreen": true
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "CapacitorHttp": {
      "enabled": true
    },
    "CapacitorCookies": {
      "enabled": true
    },
    "GoogleAuth": {
      "scopes": ["profile", "email"],
      "serverClientId": "821005945428-7qbipus2rfd5r10d0uoblo6pi23sd9l5.apps.googleusercontent.com",
      "androidClientId": "821005945428-7qbipus2rfd5r10d0uoblo6pi23sd9l5.apps.googleusercontent.com",
      "clientId": "821005945428-7qbipus2rfd5r10d0uoblo6pi23sd9l5.apps.googleusercontent.com",
      "forceCodeForRefreshToken": false,
      "grantOfflineAccess": false
    }
  }
}